{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle charts - out of every 100 Brisbane City Council events in 2025, how many were free, needed no booking, were both, and were held in a library or park",
  "data": {"url": "data/events_brisbane_2025.csv"},
  "transform": [
    {"calculate": "datum.is_free == 1 ? 1 : 0", "as": "free"},
    {
      "calculate": "datum.bookings_required == 'No' ? 1 : 0",
      "as": "no_booking"
    },
    {"calculate": "datum.free * datum.no_booking", "as": "both"},
    {
      "calculate": "datum.venue_type == 'Library' || datum.venue_type == 'Park' ? 1 : 0",
      "as": "local"
    },
    {
      "aggregate": [
        {"op": "mean", "field": "free", "as": "were free to attend"},
        {"op": "mean", "field": "no_booking", "as": "needed no booking"},
        {"op": "mean", "field": "both", "as": "were free with no booking"},
        {"op": "mean", "field": "local", "as": "were in a library or park"}
      ]
    },
    {
      "fold": [
        "were free to attend",
        "needed no booking",
        "were free with no booking",
        "were in a library or park"
      ],
      "as": ["measure", "share"]
    },
    {"calculate": "round(datum.share * 100)", "as": "count"},
    {
      "calculate": "datum.count + ' in 100 ' + datum.measure",
      "as": "heading"
    },
    {
      "calculate": "indexof(['were free to attend', 'needed no booking', 'were free with no booking', 'were in a library or park'], datum.measure)",
      "as": "position"
    },
    {"calculate": "sequence(100)", "as": "cell"},
    {"flatten": ["cell"]},
    {"calculate": "datum.cell % 10", "as": "column"},
    {"calculate": "floor(datum.cell / 10)", "as": "row"},
    {"calculate": "datum.cell < datum.count ? 'Yes' : 'No'", "as": "counted"}
  ],
  "facet": {
    "field": "heading",
    "type": "nominal",
    "sort": {"field": "position"},
    "header": {"title": null, "labelPadding": 10, "labelAnchor": "start"}
  },
  "columns": 2,
  "spacing": {"row": 34, "column": 56},
  "spec": {
    "width": 190,
    "height": 190,
    "mark": {"type": "rect", "cornerRadius": 3},
    "encoding": {
      "x": {
        "field": "column",
        "type": "ordinal",
        "axis": null,
        "scale": {"paddingInner": 0.14}
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "scale": {"paddingInner": 0.14}
      },
      "color": {
        "field": "counted",
        "type": "nominal",
        "scale": {"domain": ["Yes", "No"], "range": ["#0e5a5f", "#d3dcd9"]},
        "legend": null
      }
    }
  }
}
