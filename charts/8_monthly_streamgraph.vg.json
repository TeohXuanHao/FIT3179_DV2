{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph - Brisbane City Council events in each month of 2025 by the type of event",
  "width": "container",
  "height": 349,
  "data": {
    "url": "data/events_brisbane_2025.csv",
    "format": {"type": "csv", "parse": {"date": "date:'%Y-%m-%d'"}}
  },
  "transform": [
    {
      "calculate": "indexof(['Sports & Fitness', 'Family & Education'], datum.category_group) >= 0 ? datum.category_group : 'All other kinds'",
      "as": "kind"
    },
    {
      "calculate": "indexof(['Sports & Fitness', 'Family & Education', 'All other kinds'], datum.kind)",
      "as": "position"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "timeUnit": "month",
      "type": "temporal",
      "axis": {
        "title": null,
        "format": "%b",
        "tickCount": 12,
        "grid": true,
        "domain": false,
        "ticks": false
      }
    },
    "y": {"aggregate": "count", "stack": "center", "axis": null},
    "color": {
      "field": "kind",
      "type": "nominal",
      "scale": {
        "domain": [
          "Sports & Fitness",
          "Family & Education",
          "All other kinds"
        ],
        "range": ["#eb6834", "#2b4c7e", "#c4cdca"]
      },
      "legend": {
        "title": null,
        "orient": "bottom",
        "symbolType": "square",
        "columns": 3
      }
    },
    "order": {"field": "position"}
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "fillOpacity": 0.85,
        "stroke": "#f4f7f5",
        "strokeWidth": 1.5
      }
    },
    {
      "mark": {"type": "point", "size": 500, "opacity": 0},
      "encoding": {
        "tooltip": [
          {"field": "date", "timeUnit": "month", "title": "Month", "format": "%B"},
          {"field": "kind", "title": "Kind of event"},
          {"aggregate": "count", "title": "Events", "format": ","}
        ]
      }
    },
    {
      "transform": [
        {"timeUnit": "month", "field": "date", "as": "m"},
        {
          "aggregate": [{"op": "count", "as": "events"}],
          "groupby": ["m", "kind", "position"]
        },
        {
          "joinaggregate": [{"op": "sum", "field": "events", "as": "total"}],
          "groupby": ["m"]
        },
        {"joinaggregate": [{"op": "max", "field": "total", "as": "busiest"}]},
        {"filter": "month(datum.m) == 2"},
        {
          "window": [{"op": "sum", "field": "events", "as": "below"}],
          "sort": [{"field": "position", "order": "ascending"}],
          "frame": [null, 0]
        },
        {"calculate": "(datum.busiest - datum.total) / 2 + datum.below - datum.events / 2", "as": "mid"}
      ],
      "mark": {"type": "text", "fontWeight": 600, "fontSize": 12},
      "encoding": {
        "x": {"field": "m", "timeUnit": "month", "type": "temporal"},
        "y": {"field": "mid", "type": "quantitative", "aggregate": "min", "stack": null},
        "text": {"field": "kind"},
        "color": {
          "condition": {"test": "datum.kind == 'All other kinds'", "value": "#10292e"},
          "value": "#ffffff"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2025-06-01",
            "reach": 54,
            "note": [
              "Sport and fitness dips in June:",
              "442 events, down from 1,157 in May ↓"
            ]
          },
          {
            "date": "2025-10-01",
            "reach": 0,
            "note": [
              "Family and education events run",
              "all year, 670 to 1,010 a month"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "fontSize": 11.5,
        "fontStyle": "italic",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"value": -24},
        "color": {"value": "#47595c"},
        "text": {"field": "note"}
      }
    }
  ]
}
